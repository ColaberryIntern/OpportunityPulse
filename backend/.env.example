# =============================================================================
# Opportunity Pulse — Backend Environment Configuration
# =============================================================================
# Copy to .env and fill in actual values. NEVER commit .env to source control.
# =============================================================================

# -- Application ---------------------------------------------------------------
NODE_ENV=development
PORT=3001

# -- Database (PostgreSQL) -----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opportunity_pulse_dev
DB_USER=opportunity_pulse
DB_PASSWORD=change_me_to_secure_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# -- Authentication / JWT -------------------------------------------------------
JWT_SECRET=change_this_to_a_64_char_cryptographically_random_string_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# -- Email Service (Gmail SMTP) --------------------------------------------------
# Create a Google App Password at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on your Google account
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=your.email@gmail.com
EMAIL_VERIFICATION_URL=http://localhost:3002/verify-email

# -- CORS -----------------------------------------------------------------------
FRONTEND_URL=http://localhost:3002

# -- Rate Limiting ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# -- Logging --------------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# -- Encryption -----------------------------------------------------------------
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# -- OpenAI API (AI Analysis) --------------------------------------------------
OPENAI_API_KEY=

# -- SAM.gov API (Government Contracts) ----------------------------------------
SAM_GOV_API_KEY=

# -- Ingestion Scheduler -------------------------------------------------------
# Cron expression for automatic data ingestion (default: 6 AM daily)
# See https://crontab.guru for syntax help
INGESTION_SCHEDULE=0 6 * * *

# -- Notifications (Escalation Protocol) ----------------------------------------
NOTIFICATION_EMAIL=
SLACK_WEBHOOK_URL=
