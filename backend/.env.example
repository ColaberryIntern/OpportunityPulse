# =============================================================================
# Opportunity Pulse — Backend Environment Configuration
# =============================================================================
# Copy to .env and fill in actual values. NEVER commit .env to source control.
# =============================================================================

# -- Application ---------------------------------------------------------------
NODE_ENV=development
PORT=3001

# -- Database (PostgreSQL) -----------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opportunity_pulse_dev
DB_USER=opportunity_pulse
DB_PASSWORD=change_me_to_secure_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# -- Authentication / JWT -------------------------------------------------------
JWT_SECRET=change_this_to_a_64_char_cryptographically_random_string_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_ROUNDS=12

# -- Email Service (Gmail SMTP) --------------------------------------------------
# Create a Google App Password at https://myaccount.google.com/apppasswords
# Requires 2-Step Verification enabled on your Google account
GMAIL_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=your.email@gmail.com
EMAIL_VERIFICATION_URL=http://localhost:3002/verify-email

# -- CORS -----------------------------------------------------------------------
FRONTEND_URL=http://localhost:3002

# -- Rate Limiting ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20

# -- Logging --------------------------------------------------------------------
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# -- Encryption -----------------------------------------------------------------
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# -- OpenAI API (AI Analysis) --------------------------------------------------
OPENAI_API_KEY=

# -- SAM.gov API (Government Contracts) ----------------------------------------
# Free API key — register at https://open.gsa.gov/ (instant, no entity registration)
# 10 requests/day (public), 1000/day (with entity registration)
SAM_GOV_API_KEY=

# -- Ingestion Scheduler -------------------------------------------------------
# Cron expression for automatic data ingestion (default: 6 AM daily)
# See https://crontab.guru for syntax help
INGESTION_SCHEDULE=0 6 * * *

# -- Notifications (Escalation Protocol) ----------------------------------------
NOTIFICATION_EMAIL=
SLACK_WEBHOOK_URL=

# -- Multi-tenant override -----------------------------------------------------
# When this stack shares a host with other apps already bound to 80/443.
# NGINX_HTTP_PORT=8091
# NGINX_HTTPS_PORT=8443

# -- Bonfire Opportunity Engine + Scraper --------------------------------------
# Master flag for the BOE module (admin upload, enrichment, UI nav).
BONFIRE_ENGINE_ENABLED=false
# Master flag for the Playwright scraper. When false, /api/bonfire/scrape/run 404s.
BONFIRE_SCRAPER_ENABLED=false
# When true, register the cron schedule below. Keep false until scraper is proven.
BONFIRE_SCRAPER_CRON_ENABLED=false
# Mon/Wed/Fri 07:00 — 3x/week balances freshness vs footprint for the
# Bonfire account (procurement close-dates are days/weeks out, not hours).
BONFIRE_SCRAPER_CRON=0 7 * * 1,3,5
BONFIRE_SCRAPER_HEADLESS=true
# Vendor account credentials. Never commit. Rotate if exposed.
BONFIRE_SCRAPER_USERNAME=
BONFIRE_SCRAPER_PASSWORD=
# Phase A=vendor hub only, B=+DHA portal, C=+full agency rotation.
BONFIRE_SCRAPER_PHASE=C
# Comma-separated subdomain allow-list. Blank = use full network list.
BONFIRE_SCRAPER_AGENCY_ALLOWLIST=
# Storage location for Playwright storageState + failure counter (gitignored).
BONFIRE_SCRAPER_STORAGE_DIR=./.bonfire-session
BONFIRE_SCRAPER_SESSION_TTL_MIN=25
BONFIRE_SCRAPER_PER_AGENCY_DELAY_MS=4000
# Auto-run enrichment after each scrape so the page shows scored rows by morning.
# Costs ~$0.005/row via OpenAI; set to false if you want to gate cost manually.
BONFIRE_SCRAPER_AUTO_ENRICH=true
# Anti-detection: skip an agency portal if it was scraped successfully within
# this window. 72h means each agency is hit at most every 3 days even on a
# Mon/Wed/Fri schedule. Set to 0 to disable the gate (every run hits every agency).
BONFIRE_SCRAPER_AGENCY_FRESHNESS_HOURS=72
# Shuffle the agency-iteration order each run so we don't scrape the same
# subdomain at the same time-offset every day (recognisable pattern).
BONFIRE_SCRAPER_SHUFFLE_AGENCIES=true
